{
  "name": "think-collapse",
  "version": "2.0.0",
  "description": "Collapse the full pre-result process of each assistant turn into one Codex-style duration row. · 将每轮最终结果前的完整过程折叠为 Codex 风格耗时行。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "think", "reasoning", "collapse"],
  "files": ["lib", "client", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
